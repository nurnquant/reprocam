# Copy to .env and fill in. NEVER commit .env.

# Meta Model API (dev.meta.ai) — needed for Muse Spark, Voice Transcribe, SAM 3.1
# Key format: LLM|<numeric_id>|<secret>
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3

# Baseten — Muse Spark Open (open-weight bonus). Guide says -1026 but it 404s; this id works (verified Oct 31):
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open

# Fireworks — Muse Spark Open (verify id in Fireworks model library)
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/models/muse-spark-open

# Which provider powers the agent's reasoning: meta | baseten | fireworks
LLM_PROVIDER=fireworks

# Cost guard for the public demo (Meta "Spend Limit" is only an alert)
MAX_RUNS_PER_DAY=30
MAX_RUNS_PER_IP=3

# Reasoning effort per stage (Muse Spark Open does not accept "none"). Tune via M4b sweep.
EFFORT_UNDERSTAND=low
EFFORT_TESTGEN=low
EFFORT_JUDGE=low

# Judge: muse (Muse Spark Open via LLM_PROVIDER) | glimmer (tuned deployment, M9)
JUDGE_PROVIDER=muse
GLIMMER_DEPLOYMENT=

# Known-good build (optional, off when blank): a build where the bug doesn't happen, e.g. the
# last release. The test must pass there; if it fails there too, the test is retried. Use "fixed"
# for the practice store's ?fixed=1 (our samples are made this way).
KNOWN_GOOD_URL=

# SAM 3.1 evidence: image mode on the bug frame (default) or 1 = track through the whole video
SAM_VIDEO_TRACK=0

# Cost estimates in logs (USD per 1M tokens). Fill from each provider's pricing page; blank = not estimated.
PRICE_FIREWORKS_IN=
PRICE_FIREWORKS_OUT=
PRICE_BASETEN_IN=
PRICE_BASETEN_OUT=
PRICE_META_IN=
PRICE_META_OUT=
# Voice Transcribe, USD per minute of audio (fill once confirmed on dev.meta.ai)
PRICE_META_ASR=
