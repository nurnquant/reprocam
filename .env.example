# Copy to .env and fill in. NEVER commit .env.

# Meta Model API (dev.meta.ai) — needed for Muse Spark, Voice Transcribe, SAM 3.1
# Key format: LLM|<numeric_id>|<secret>
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3

# Baseten — Muse Spark Open (open-weight bonus). The hackathon key ($100 credits, 2M TPM) works only with the
# -1026 id (Baseten's email, Nov 1); a regular key used meta-models/muse-spark-open. At most 8 images per request.
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026

# Fireworks — Muse Spark Open (verify id in Fireworks model library)
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/models/muse-spark-open

# Which provider powers the agent's reasoning: meta | baseten | fireworks
# (results in README and docs/ were measured on fireworks; the live app now runs on baseten)
LLM_PROVIDER=baseten
# Understanding (frames + narration) only; blank = LLM_PROVIDER. meta = Muse Spark 1.3, no image cap
UNDERSTAND_PROVIDER=meta

# Cost guard for the public demo (Meta "Spend Limit" is only an alert)
MAX_RUNS_PER_DAY=30
MAX_RUNS_PER_IP=3

# Reasoning effort per stage (Muse Spark Open does not accept "none"). testgen/judge: low; from the
# M4b effort test: on our 3 bugs no level was clearly better (7/9, 8/9, 7/9); low for speed and cost.
EFFORT_UNDERSTAND=low
EFFORT_TESTGEN=low
EFFORT_JUDGE=low

# Judge: muse (Muse Spark Open via LLM_PROVIDER) | glimmer (tuned deployment, M9)
JUDGE_PROVIDER=muse
GLIMMER_DEPLOYMENT=

# Known-good build (optional, off when blank): a build where the bug doesn't happen, e.g. the
# last release. The test must pass there; if it fails there too, the test is retried. Use "fixed"
# for the practice store's ?fixed=1 (our samples are made this way).
KNOWN_GOOD_URL=

# SAM 3.1 evidence: image mode on the bug frame (default) or 1 = track through the whole video
SAM_VIDEO_TRACK=0

# Cost estimates in logs (USD per 1M tokens). Fill from each provider's pricing page; blank = not estimated.
PRICE_FIREWORKS_IN=
PRICE_FIREWORKS_OUT=
# Baseten: 1.25 / 4.25 from a third-party tracker (Nov 1 2026), not yet confirmed on baseten.co/pricing
PRICE_BASETEN_IN=
PRICE_BASETEN_OUT=
PRICE_META_IN=
PRICE_META_OUT=
# Voice Transcribe, USD per minute of audio (fill once confirmed on dev.meta.ai)
PRICE_META_ASR=
